{
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dev": "concurrently -k -n web,desktop \"npm run dev:web\" \"wait-on http://127.0.0.1:5173 && npm run dev:desktop\"",
    "dev:web": "npm --prefix webui run dev -- --host 127.0.0.1 --strictPort",
    "dev:desktop": "STUDIO_DEV_URL=http://127.0.0.1:5173 electron .",
    "build": "npm --prefix webui run build",
    "start": "electron .",
    "test:desktop": "npm run test:node && npm run test:python",
    "lint": "eslint desktop scripts/*.mjs webui ./*.mjs --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write --ignore-unknown desktop webui/src \"webui/*.{json,ts,js,html}\" \"*.{json,mjs,cjs}\" docs/studio.md .github/workflows/studio-checks.yml",
    "format:check": "prettier --check --ignore-unknown desktop webui/src \"webui/*.{json,ts,js,html}\" \"*.{json,mjs,cjs}\" docs/studio.md .github/workflows/studio-checks.yml",
    "typecheck": "npm --prefix webui run typecheck",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "check:all": "npm run check && npm run test:desktop",
    "test:node": "node --test desktop/tests/*.test.mjs",
    "test:python": "uv run --locked python -m pytest desktop/tests tests/cli -q",
    "cli": "uv run --locked mediacrawler",
    "probe": "uv run --no-sync python scripts/studio_probe.py",
    "test:cli": "uv run --locked pytest tests/cli -q",
    "build:cli": "uv run --locked --group build python scripts/build_cli.py",
    "build:desktop": "node scripts/build-desktop.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "mermaid": "^11.12.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.72.1",
    "vitepress": "^1.3.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "wait-on": "^9.5.1"
  },
  "name": "mediacrawler-studio",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  }
}
